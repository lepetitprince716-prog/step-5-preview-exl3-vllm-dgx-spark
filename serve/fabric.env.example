# Copy to a private file on the head (chmod 600), fill in the fabric IPv4 address of each node, and pass its path to
# launch2.sh as FABRIC_ENV. Never commit the filled file. launch2.sh sources it and checks every value on its node.
# The interface and HCA names below are the ones of the nodes this release was measured on; confirm yours on each node
# with `rdma link` and `ls /sys/class/net/<ifname>/device/infiniband/` before the first start.
HEAD_IP=
HEAD_IFNAME=enp1s0f1np1
HEAD_HCAS=rocep1s0f1
WORKER_IPS=
WORKER_IFNAMES=enp1s0f1np1
WORKER_HCAS=rocep1s0f1
